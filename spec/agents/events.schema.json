{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naiuz/sdk/spec/agents/events.schema.json",
  "title": "NeuronAI agents protocol 0.2",
  "description": "The events of the agents WebSocket protocol. protocol.md describes how they are used.",
  "$defs": {
    "ClientEvent": {
      "description": "Every event a client sends.",
      "oneOf": [
        {
          "$ref": "#/$defs/ConversationInitiationClientData"
        },
        {
          "$ref": "#/$defs/ClientUserMessage"
        },
        {
          "$ref": "#/$defs/Pong"
        },
        {
          "$ref": "#/$defs/Playback"
        },
        {
          "$ref": "#/$defs/ClientToolResult"
        },
        {
          "$ref": "#/$defs/ContextualUpdate"
        },
        {
          "$ref": "#/$defs/UserActivity"
        },
        {
          "$ref": "#/$defs/Feedback"
        }
      ]
    },
    "ServerEvent": {
      "description": "Every event the server sends.",
      "oneOf": [
        {
          "$ref": "#/$defs/ConversationInitiationMetadata"
        },
        {
          "$ref": "#/$defs/ConversationHistory"
        },
        {
          "$ref": "#/$defs/MessageAck"
        },
        {
          "$ref": "#/$defs/MessageError"
        },
        {
          "$ref": "#/$defs/ServerUserMessage"
        },
        {
          "$ref": "#/$defs/AgentTyping"
        },
        {
          "$ref": "#/$defs/AgentChatResponsePart"
        },
        {
          "$ref": "#/$defs/AgentResponse"
        },
        {
          "$ref": "#/$defs/AgentResponseCorrection"
        },
        {
          "$ref": "#/$defs/OperatorMessage"
        },
        {
          "$ref": "#/$defs/Handoff"
        },
        {
          "$ref": "#/$defs/TurnDebug"
        },
        {
          "$ref": "#/$defs/Ping"
        },
        {
          "$ref": "#/$defs/ConversationEnded"
        },
        {
          "$ref": "#/$defs/ErrorEvent"
        },
        {
          "$ref": "#/$defs/AgentState"
        },
        {
          "$ref": "#/$defs/UserTranscript"
        },
        {
          "$ref": "#/$defs/AudioPause"
        },
        {
          "$ref": "#/$defs/AudioResume"
        },
        {
          "$ref": "#/$defs/Interruption"
        },
        {
          "$ref": "#/$defs/ClientToolCall"
        },
        {
          "$ref": "#/$defs/AgentToolResponse"
        },
        {
          "$ref": "#/$defs/LanguageChanged"
        }
      ]
    },
    "LanguageCode": {
      "description": "A language the platform speaks.",
      "enum": [
        "uz",
        "ru",
        "en"
      ]
    },
    "ConversationId": {
      "type": "string",
      "pattern": "^conv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ClientMessageId": {
      "description": "The client's own id for a message, the same on every retry.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "MessageId": {
      "type": "integer",
      "minimum": 1
    },
    "EventId": {
      "description": "Counts up per conversation, across turns.",
      "type": "integer",
      "minimum": 1
    },
    "DateTime": {
      "type": "string",
      "format": "date-time"
    },
    "Overrides": {
      "type": "object",
      "properties": {
        "prompt": {
          "description": "The agent's prompt for this session, in place of its own.",
          "type": "string",
          "minLength": 1,
          "maxLength": 30000
        },
        "first_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "language": {
          "$ref": "#/$defs/LanguageCode"
        },
        "voice": {
          "description": "A voice the organization can use.",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_]+:[A-Za-z0-9_.-]+$"
            },
            "speed": {
              "type": "number",
              "minimum": 0.7,
              "maximum": 1.2
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "model": {
          "description": "A model the organization can choose. A customer's own endpoint can't be named.",
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "neuronai",
                "external"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "source",
            "id"
          ],
          "additionalProperties": false
        },
        "text_only": {
          "description": "Decides whether the session is text or a call, over the frame's own text_only.",
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Features": {
      "type": "object",
      "properties": {
        "text": {
          "type": "boolean"
        },
        "voice": {
          "type": "boolean"
        },
        "debug": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "voice",
        "debug"
      ],
      "additionalProperties": false
    },
    "HistoryMessage": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "customer",
            "agent",
            "operator"
          ]
        },
        "text": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/DateTime"
        },
        "message_id": {
          "description": "The message's id once the server has stored it, as its message_ack gave it; null for a reply not stored yet.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "client_message_id": {
          "description": "For a customer's message sent through a socket, the client_message_id it was sent with; null otherwise.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "required": [
        "role",
        "text",
        "at",
        "message_id",
        "client_message_id"
      ],
      "additionalProperties": false
    },
    "TextResponsePart": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "start",
            "delta",
            "stop"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "Operator": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatar_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "avatar_url"
      ],
      "additionalProperties": false
    },
    "TurnTimings": {
      "type": "object",
      "properties": {
        "queue_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "first_token_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stt_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tts_first_chunk_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "queue_ms",
        "first_token_ms",
        "model_ms",
        "stt_ms",
        "tts_first_chunk_ms",
        "total_ms"
      ],
      "additionalProperties": false
    },
    "UsageItem": {
      "type": "object",
      "properties": {
        "service": {
          "enum": [
            "llm",
            "stt",
            "tts_v3"
          ]
        },
        "model": {
          "type": "string"
        },
        "source": {
          "enum": [
            "neuronai",
            "external",
            "custom"
          ]
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "audio_seconds": {
          "type": "number",
          "minimum": 0
        },
        "characters": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "description": "OpenRouter's reported cost, as a decimal string.",
          "type": [
            "string",
            "null"
          ]
        },
        "estimated": {
          "type": "boolean"
        }
      },
      "required": [
        "service",
        "model",
        "source",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "audio_seconds",
        "characters",
        "cost_usd",
        "estimated"
      ],
      "additionalProperties": false
    },
    "ConversationInitiationClientData": {
      "description": "The client's half of the handshake, its first frame.",
      "type": "object",
      "properties": {
        "type": {
          "const": "conversation_initiation_client_data"
        },
        "dynamic_variables": {
          "description": "Values for the agent's variables. Signed values in the token win.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "overrides": {
          "$ref": "#/$defs/Overrides"
        },
        "text_only": {
          "description": "False asks for a call. Left out, the session is text.",
          "type": "boolean"
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "audio": {
          "$ref": "#/$defs/AudioFormats"
        },
        "client_tools": {
          "description": "The client tools this page runs, by name. A call to any other answers \"not available\" to the agent.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolName"
          },
          "maxItems": 32
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "ClientUserMessage": {
      "description": "A message the user typed.",
      "type": "object",
      "properties": {
        "type": {
          "const": "user_message"
        },
        "client_message_id": {
          "$ref": "#/$defs/ClientMessageId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      },
      "required": [
        "type",
        "client_message_id",
        "text"
      ],
      "additionalProperties": false
    },
    "Pong": {
      "description": "The answer to a ping.",
      "type": "object",
      "properties": {
        "type": {
          "const": "pong"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        }
      },
      "required": [
        "type",
        "event_id"
      ],
      "additionalProperties": false
    },
    "ConversationInitiationMetadata": {
      "description": "The server's half of the handshake.",
      "type": "object",
      "properties": {
        "type": {
          "const": "conversation_initiation_metadata"
        },
        "conversation_id": {
          "$ref": "#/$defs/ConversationId"
        },
        "resume_token": {
          "description": "Reconnects to this conversation. Keep only the newest.",
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "new",
            "ai_handling",
            "human_handling",
            "resolved",
            "reopened",
            "in_call"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LanguageCode"
          },
          "minItems": 1
        },
        "language": {
          "$ref": "#/$defs/LanguageCode"
        },
        "features": {
          "$ref": "#/$defs/Features"
        },
        "audio": {
          "description": "The call's audio formats; null for a text session.",
          "anyOf": [
            {
              "$ref": "#/$defs/AudioFormats"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "conversation_id",
        "resume_token",
        "status",
        "languages",
        "language",
        "features",
        "audio"
      ],
      "additionalProperties": false
    },
    "ConversationHistory": {
      "description": "On a resume: the messages so far, oldest first.",
      "type": "object",
      "properties": {
        "type": {
          "const": "conversation_history"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryMessage"
          }
        }
      },
      "required": [
        "type",
        "messages"
      ],
      "additionalProperties": false
    },
    "MessageAck": {
      "description": "The message is saved.",
      "type": "object",
      "properties": {
        "type": {
          "const": "message_ack"
        },
        "client_message_id": {
          "$ref": "#/$defs/ClientMessageId"
        },
        "message_id": {
          "$ref": "#/$defs/MessageId"
        },
        "occurred_at": {
          "$ref": "#/$defs/DateTime"
        }
      },
      "required": [
        "type",
        "client_message_id",
        "message_id",
        "occurred_at"
      ],
      "additionalProperties": false
    },
    "MessageError": {
      "description": "The message wasn't saved. Send it again if retryable.",
      "type": "object",
      "properties": {
        "type": {
          "const": "message_error"
        },
        "client_message_id": {
          "$ref": "#/$defs/ClientMessageId"
        },
        "retryable": {
          "type": "boolean"
        },
        "code": {
          "enum": [
            "refused",
            "unavailable",
            "invalid",
            "rate_limited"
          ]
        }
      },
      "required": [
        "type",
        "client_message_id",
        "retryable",
        "code"
      ],
      "additionalProperties": false
    },
    "ServerUserMessage": {
      "description": "A message another viewer of the conversation sent.",
      "type": "object",
      "properties": {
        "type": {
          "const": "user_message"
        },
        "client_message_id": {
          "$ref": "#/$defs/ClientMessageId"
        },
        "message_id": {
          "$ref": "#/$defs/MessageId"
        },
        "text": {
          "type": "string"
        },
        "occurred_at": {
          "$ref": "#/$defs/DateTime"
        }
      },
      "required": [
        "type",
        "client_message_id",
        "message_id",
        "text",
        "occurred_at"
      ],
      "additionalProperties": false
    },
    "AgentTyping": {
      "description": "Shown before a text reply.",
      "type": "object",
      "properties": {
        "type": {
          "const": "agent_typing"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "AgentChatResponsePart": {
      "description": "One piece of a streamed reply.",
      "type": "object",
      "properties": {
        "type": {
          "const": "agent_chat_response_part"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "text_response_part": {
          "$ref": "#/$defs/TextResponsePart"
        }
      },
      "required": [
        "type",
        "event_id",
        "text_response_part"
      ],
      "additionalProperties": false
    },
    "AgentResponse": {
      "description": "The final text of a reply.",
      "type": "object",
      "properties": {
        "type": {
          "const": "agent_response"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "event_id",
        "text"
      ],
      "additionalProperties": false
    },
    "AgentResponseCorrection": {
      "description": "Replaces what the client has of a reply; an empty text withdraws it.",
      "type": "object",
      "properties": {
        "type": {
          "const": "agent_response_correction"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "event_id",
        "text"
      ],
      "additionalProperties": false
    },
    "OperatorMessage": {
      "description": "An operator's reply.",
      "type": "object",
      "properties": {
        "type": {
          "const": "operator_message"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "text": {
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/Operator"
        }
      },
      "required": [
        "type",
        "event_id",
        "text",
        "operator"
      ],
      "additionalProperties": false
    },
    "Handoff": {
      "description": "The conversation passed to operators; the agent stays silent.",
      "type": "object",
      "properties": {
        "type": {
          "const": "handoff"
        },
        "reason": {
          "enum": [
            "agent",
            "agent_failed",
            "balance"
          ]
        },
        "mode_outcome": {
          "enum": [
            "continue_as_text"
          ]
        }
      },
      "required": [
        "type",
        "reason",
        "mode_outcome"
      ],
      "additionalProperties": false
    },
    "TurnDebug": {
      "description": "For testers only (caps.debug): how a turn ran.",
      "type": "object",
      "properties": {
        "type": {
          "const": "turn_debug"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_used": {
          "type": "boolean"
        },
        "timings": {
          "$ref": "#/$defs/TurnTimings"
        },
        "usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UsageItem"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error_code": {
          "description": "Why the turn failed, for the builder's preview: model_timeout, model_unavailable, model_error, egress_blocked, config_invalid, config_unavailable, secret_missing, turn_expired or internal. Null when the turn went through. Treat a code you don't know as internal.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool_calls": {
          "description": "The turn's tool calls, in the order the agent made them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TurnToolCall"
          }
        },
        "knowledge": {
          "description": "The passages of the agent's documents the model read, best first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TurnPassage"
          }
        }
      },
      "required": [
        "type",
        "event_id",
        "turn_id",
        "step",
        "model",
        "fallback_used",
        "timings",
        "usage",
        "warnings",
        "error_code"
      ],
      "additionalProperties": false
    },
    "Ping": {
      "description": "Answer with a pong carrying the same event id.",
      "type": "object",
      "properties": {
        "type": {
          "const": "ping"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        }
      },
      "required": [
        "type",
        "event_id"
      ],
      "additionalProperties": false
    },
    "ConversationEnded": {
      "description": "The conversation ended; the server closes with 1000.",
      "type": "object",
      "properties": {
        "type": {
          "const": "conversation_ended"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false
    },
    "ErrorEvent": {
      "description": "A frame the server couldn't use. The socket stays open.",
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "enum": [
            "unknown_event",
            "invalid_event",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "AudioFormat": {
      "description": "PCM16 little-endian mono at the named sample rate.",
      "enum": [
        "pcm_16000",
        "pcm_24000"
      ]
    },
    "AudioEnvironment": {
      "description": "What the client mixes into a call: a background, and the agent's voice as on a phone line.",
      "type": "object",
      "properties": {
        "ambience_url": {
          "description": "Where the sound is, relative to the socket's address; null for none. A sound that won't load is no sound.",
          "type": [
            "string",
            "null"
          ]
        },
        "volume": {
          "description": "0 to 1.",
          "type": "number"
        },
        "phone_filter": {
          "description": "The agent's voice between 300 and 3,400 Hz.",
          "type": "boolean"
        }
      },
      "required": [
        "ambience_url",
        "volume",
        "phone_filter"
      ],
      "additionalProperties": false
    },
    "AudioFormats": {
      "description": "A call's audio: the client sends 16 kHz, and gets the output rate it asked for.",
      "type": "object",
      "properties": {
        "input": {
          "enum": [
            "pcm_16000"
          ]
        },
        "output": {
          "$ref": "#/$defs/AudioFormat"
        },
        "environment": {
          "description": "What the client plays under the agent. On the server's side only; the agent never hears it.",
          "$ref": "#/$defs/AudioEnvironment"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "Playback": {
      "description": "How much of a reply's audio has played: every 250 ms while it plays, once when it pauses, and once when its audio ends.",
      "type": "object",
      "properties": {
        "type": {
          "const": "playback"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "played_ms": {
          "description": "Milliseconds of that reply's audio played since its first frame, pauses excluded.",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "event_id",
        "played_ms"
      ],
      "additionalProperties": false
    },
    "AgentState": {
      "description": "What the agent is doing in a call, which drives the orb.",
      "type": "object",
      "properties": {
        "type": {
          "const": "agent_state"
        },
        "state": {
          "enum": [
            "listening",
            "thinking",
            "speaking"
          ]
        }
      },
      "required": [
        "type",
        "state"
      ],
      "additionalProperties": false
    },
    "UserTranscript": {
      "description": "What the customer said in a call, once their turn ended.",
      "type": "object",
      "properties": {
        "type": {
          "const": "user_transcript"
        },
        "text": {
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/LanguageCode"
        },
        "occurred_at": {
          "$ref": "#/$defs/DateTime"
        }
      },
      "required": [
        "type",
        "text",
        "language",
        "occurred_at"
      ],
      "additionalProperties": false
    },
    "AudioPause": {
      "description": "The customer started speaking over a reply: pause its playback and keep the buffer.",
      "type": "object",
      "properties": {
        "type": {
          "const": "audio_pause"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        }
      },
      "required": [
        "type",
        "event_id"
      ],
      "additionalProperties": false
    },
    "AudioResume": {
      "description": "Nothing to answer was said: resume the paused reply where it stopped.",
      "type": "object",
      "properties": {
        "type": {
          "const": "audio_resume"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        }
      },
      "required": [
        "type",
        "event_id"
      ],
      "additionalProperties": false
    },
    "Interruption": {
      "description": "The customer interrupted: drop the reply's audio, up to and including this response.",
      "type": "object",
      "properties": {
        "type": {
          "const": "interruption"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        }
      },
      "required": [
        "type",
        "event_id"
      ],
      "additionalProperties": false
    },
    "ToolName": {
      "description": "A tool's name: snake_case, as the agent's builder named it.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "ToolCallId": {
      "description": "One call's id, the same on its call and its result.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "ClientToolCall": {
      "description": "The agent asks the page to run one of its client tools. With expects_response, the agent waits for the page's client_tool_result, up to the tool's timeout.",
      "type": "object",
      "properties": {
        "type": {
          "const": "client_tool_call"
        },
        "tool_call_id": {
          "$ref": "#/$defs/ToolCallId"
        },
        "tool_name": {
          "$ref": "#/$defs/ToolName"
        },
        "parameters": {
          "description": "The values the agent filled, as the tool's parameters describe them.",
          "type": "object",
          "additionalProperties": true
        },
        "expects_response": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "tool_call_id",
        "tool_name",
        "parameters",
        "expects_response"
      ],
      "additionalProperties": false
    },
    "ClientToolResult": {
      "description": "The page's answer to a client_tool_call. The agent reads it as data, never as instructions. The first answer to a call wins.",
      "type": "object",
      "properties": {
        "type": {
          "const": "client_tool_result"
        },
        "tool_call_id": {
          "$ref": "#/$defs/ToolCallId"
        },
        "result": {
          "description": "What the tool returned, as text; JSON for anything else.",
          "type": "string",
          "maxLength": 8000
        },
        "is_error": {
          "description": "True when the tool couldn't do it; result says why.",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "tool_call_id",
        "result",
        "is_error"
      ],
      "additionalProperties": false
    },
    "TurnToolCall": {
      "description": "One tool call of a turn, secrets masked.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "system",
            "webhook",
            "client",
            "mcp",
            "integration",
            "transition"
          ]
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        },
        "result": {
          "description": "What the agent read back.",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "timeout",
            "rejected"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "name",
        "arguments",
        "result",
        "status",
        "error_code",
        "http_status",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "TurnPassage": {
      "description": "A passage of a document a turn used.",
      "type": "object",
      "properties": {
        "document_id": {
          "type": "integer",
          "minimum": 1
        },
        "document_name": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ]
        },
        "heading": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": "number"
        },
        "excerpt": {
          "type": "string",
          "description": "The start of the passage."
        }
      },
      "required": [
        "document_id",
        "document_name",
        "page",
        "heading",
        "score",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "ContextualUpdate": {
      "description": "Something the page wants the agent to know, such as what the customer is looking at. It interrupts nothing, and the agent reads it as information, never as instructions. A newer update with the same context_id replaces the older one.",
      "type": "object",
      "properties": {
        "type": {
          "const": "contextual_update"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "context_id": {
          "description": "Your own id for what this update is about. Left out, the update stands on its own.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "UserActivity": {
      "description": "The customer is typing, so the agent holds off for about 2 seconds.",
      "type": "object",
      "properties": {
        "type": {
          "const": "user_activity"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "Feedback": {
      "description": "The customer's view of a reply, by its event_id. A null score takes it back.",
      "type": "object",
      "properties": {
        "type": {
          "const": "feedback"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "score": {
          "enum": [
            "like",
            "dislike",
            null
          ]
        }
      },
      "required": [
        "type",
        "event_id",
        "score"
      ],
      "additionalProperties": false
    },
    "AgentToolResponse": {
      "description": "A tool the agent is using: its name, its type and how it's going. Never its values or its result.",
      "type": "object",
      "properties": {
        "type": {
          "const": "agent_tool_response"
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "tool_type": {
          "enum": [
            "system",
            "webhook",
            "client",
            "mcp",
            "integration",
            "transition"
          ]
        },
        "status": {
          "enum": [
            "running",
            "done",
            "failed"
          ]
        }
      },
      "required": [
        "type",
        "tool_name",
        "tool_type",
        "status"
      ],
      "additionalProperties": false
    },
    "LanguageChanged": {
      "description": "The agent moved to this language, and what it says from here on is in it.",
      "type": "object",
      "properties": {
        "type": {
          "const": "language_changed"
        },
        "language": {
          "$ref": "#/$defs/LanguageCode"
        }
      },
      "required": [
        "type",
        "language"
      ],
      "additionalProperties": false
    }
  }
}
