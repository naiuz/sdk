{
  "name": "@naiuz/agents-workspace",
  "private": true,
  "type": "module",
  "description": "The agents packages: the protocol's types, the client, the Vue and React packages, and the widget.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "protocol",
    "client",
    "vue",
    "react",
    "widget"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm test --workspaces",
    "generate": "npm run generate --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.44"
  }
}
