{
  "name": "@naiuz/agents-protocol",
  "version": "0.1.0",
  "description": "The types of the NeuronAI agents protocol, generated from its JSON Schema.",
  "keywords": [
    "neuronai",
    "agents",
    "websocket",
    "protocol"
  ],
  "homepage": "https://github.com/naiuz/sdk/tree/main/agents/protocol#readme",
  "bugs": {
    "url": "https://github.com/naiuz/sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naiuz/sdk.git",
    "directory": "agents/protocol"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs"
  }
}
